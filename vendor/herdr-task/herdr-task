#!/usr/bin/env python3
"""herdr-task: Herdr's tasks, the one way to change them.

A task is a name and a prompt that belongs to one folder: the repo root when the folder is in
git (a linked worktree counts as its main repo), else the folder itself. Each folder's tasks are
one JSON file on the machine where the folder lives, ~/.herdr/tasks/<slug>.json, never inside a
repo. Every write takes the file's lock and replaces it atomically, so the Tasks panel, agents and
coordinators never clash.

States: todo -> running -> ready -> done. Queue waits and future starts are metadata on todo, not
Task states. A driver reports progress and delivers summary, details and a proof object at ready;
accept (ready only) or done (drop/finalization) records done_at and done_by. Rework uses start to
move ready back to running. Merge, comment and close are playbook delivery, never Task transitions.
Every agent started for a task carries the hc label herdr.task=<key> (key: <slug>#<id>).
"""

import os
import sys

# Its package beside it (or inside it, as a zipapp); no __pycache__ in the mod's folder.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from herdr_task.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
