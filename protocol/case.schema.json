{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collie:case:v1",
  "title": "Case",
  "description": "内核递给 Coordinator 的一条 Message 上下文：来源 + 有界快照。它只存在于 Ledger；人和事件共用一套记忆（Ledger），不按 turn 类型拆协议。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "created_at",
    "space",
    "message",
    "origin",
    "scope",
    "snapshot",
    "memory",
    "instruction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ca_[0-9a-z]{8,32}$",
      "description": "Case 标识，ca_ 前缀加 8–32 位小写字母数字。一个 Case 对应最多一次唤醒计费。"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "递出时刻。**预算的唯一计费依据**：invariants.checkBudget 按它数窗口内的 Case 数。"
    },
    "origin": {
      "enum": [
        "event",
        "human"
      ],
      "description": "这个 CoordinatorTurn 由外部事件还是人的消息触发；两者共享同一 Case/Decision 契约。"
    },
    "playbook": {
      "type": [
        "object",
        "null"
      ],
      "description": "这个 turn 选定的 playbook；null 表示尚未选择。",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
          "description": "playbook 的稳定 name，来自 playbook registry。"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "playbook 版本，Task 锁定该版本。"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playbooks"
      ],
      "description": "程序注入的动态 playbook 注册表。只含选择所需的元数据，不含 prompt 正文。",
      "properties": {
        "playbooks": {
          "description": "可用 playbook 的元数据；Coordinator 只能从这里选择。",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
                "description": "playbook 的稳定 name。"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "description": "一句话说明，用于选择。"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "description": "锁定进 Decision 的版本。"
              }
            }
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "candidates",
        "resolution"
      ],
      "description": "[开放问题 #5] 归属解算结果。判断按 space 切，所以这条必须显式落盘，不能靠 coordinator 猜。",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
          "description": "这条事件归哪个 space 的 coordinator 判。多候选时的胜者由 resolution 说明依据。"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 8,
          "description": "全部候选 space（folder→space 表命中的结果）。长度 >1 即为跨 space 事件，是否出卡问人尚未拍板。"
        },
        "resolution": {
          "enum": [
            "single",
            "remembered",
            "card"
          ],
          "description": "候选怎么收敛成 primary：single=只有一个候选；remembered=人上次的选择；card=这次出卡问了人。"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "candidates"
            ],
            "properties": {
              "candidates": {
                "minItems": 2
              }
            }
          },
          "then": {
            "required": [
              "resolution"
            ],
            "properties": {
              "resolution": {
                "enum": [
                  "remembered",
                  "card"
                ]
              }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbidden_expand",
        "snapshot_bytes_max"
      ],
      "description": "[照抄 agent-autoloop 会坏的第 2 处的前置] coordinator 只能看内核给的快照，不许自己 git/gh 扩大视野——否则『全局』会变成『全局噪音』（DESIGN §3.2）。",
      "properties": {
        "forbidden_expand": {
          "const": true,
          "description": "禁止主动扩大视野（跑 git/gh/网络查询补上下文）。可选 helper 必须派成不入任务库的侧任务。"
        },
        "snapshot_bytes_max": {
          "const": 4096,
          "description": "快照硬上限 4KB。冻结为常量：它同时是『上下文撑爆』这条风险的缓解措施。"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "truncated",
        "space_note",
        "queue",
        "running",
        "recent",
        "active",
        "rules_version",
        "budget"
      ],
      "description": "有界快照（DESIGN §3.2）。由内核拼，coordinator 只读。",
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "description": "实际序列化字节数，硬上限 4096。超了就截断并置 truncated。"
        },
        "truncated": {
          "type": "boolean",
          "description": "是否截断过。true 时 coordinator 应当只做粗判，并把细节留给 worker。"
        },
        "space_note": {
          "type": "string",
          "maxLength": 500,
          "description": "这个 space 的 folder / base / 约定摘要，一句话。"
        },
        "queue": {
          "type": "array",
          "maxItems": 10,
          "description": "未结的等待决定（每条一行 key + 40 字理由），最多 10 条。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "why"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "description": "决定的 key，用于跟进。"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "40 字以内的理由，防止快照被长文本吃掉。"
              }
            }
          }
        },
        "running": {
          "type": "array",
          "maxItems": 16,
          "description": "在跑的任务，每条带 task id、状态、状态行与时长的秒数。**判断依据是状态有没有前进**，不是进程在不在。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "state",
              "state_changed_at",
              "elapsed_seconds"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "description": "collie-task canonical task ref。"
              },
              "state": {
                "enum": ["todo", "running", "ready", "done"],
                "description": "共享 Task 的四态执行事实，原样带入 Coordinator 快照。"
              },
              "state_changed_at": {
                "type": "string",
                "format": "date-time",
                "description": "[照抄 autoloop 会坏的第 1 处] 最近一次状态变化时刻。用它算『多久没前进』，而不是用进程存活与否。"
              },
              "elapsed_seconds": {
                "type": "integer",
                "minimum": 0,
                "description": "已运行秒数。与 state_changed_at 一起区分『长的正常任务』与『卡住的 unknown』。"
              }
            }
          }
        },
        "recent": {
          "type": "array",
          "maxItems": 10,
          "description": "该 space 最近的决定（防抖，DESIGN §3.2『读最近 10 条决定』）。这是记忆外置的读视图，实体在 Ledger。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "object_key",
              "why"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "pattern": "^dc_[0-9a-z]{8,32}$",
                "description": "决定 id。"
              },
              "object_key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*:.+$",
                "description": "该决定绑定的对象键。"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140,
                "description": "当时的一行理由，用来防止同一件事被反复改判。"
              }
            }
          }
        },
        "active": {
          "type": "array",
          "maxItems": 10,
          "description": "未终结的 Decision 与 orphan Task 的只读判断视图。身份来自 Ledger / Task store；目标与详情用于语义续接，不新增实体。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "task_ref", "kind", "goal", "detail_ref", "decision_state", "task_state"],
            "properties": {
              "decision_id": {
                "type": ["string", "null"],
                "pattern": "^dc_[0-9a-z]{8,32}$",
                "description": "可续接的 Decision；orphan Task 为 null。"
              },
              "task_ref": {
                "type": ["string", "null"],
                "maxLength": 240,
                "description": "canonical Task ref；尚未派发时为 null。"
              },
              "kind": {
                "enum": ["build", "review", "verify", null],
                "description": "Task 当前动作；未知或 orphan 未分类时为 null，不参与身份去重。"
              },
              "goal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "目标摘要，供 Coordinator 判断是否同一目标。"
              },
              "detail_ref": {
                "type": ["string", "null"],
                "pattern": "^/[^\\s]+$",
                "description": "完整 Task brief 的本地引用；需要细节时读取，不把长正文塞进快照。"
              },
              "decision_state": {
                "enum": ["open", "waiting", null],
                "description": "活跃 Decision 状态；orphan Task 为 null。"
              },
              "task_state": {
                "enum": ["todo", "running", "ready", "done", null],
                "description": "当前 Task 执行事实；尚未关联 Task 时为 null。"
              }
            }
          }
        },
        "rules_version": {
          "type": "integer",
          "minimum": 1,
          "description": "本次判断依据的规则集版本号（Ruleset.version）。"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "limit",
            "used",
            "remaining",
            "window_start",
            "reset_at"
          ],
          "description": "**全局**预算剩余，不是本 space 的（DESIGN §3.2：按 space 算 10 个 space 就是 60 次）。",
          "properties": {
            "scope": {
              "const": "global",
              "description": "计费域，冻结为 global。"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "窗口上限，默认 100。"
            },
            "used": {
              "type": "integer",
              "minimum": 0,
              "description": "窗口内已用次数（全 machine 合计）。"
            },
            "remaining": {
              "type": "integer",
              "minimum": 0,
              "description": "剩余次数。为 0 时内核不再递 Case，降级为卡片。"
            },
            "window_start": {
              "type": "string",
              "format": "date-time",
              "description": "窗口起点。"
            },
            "reset_at": {
              "type": "string",
              "format": "date-time",
              "description": "窗口滑出、预算恢复的时刻。"
            }
          }
        },
        "policy": {
          "type": "string",
          "maxLength": 2000,
          "description": "该 space 的用户 policy（自然语言）。内置 policy 在提示词里；这里只放用户覆盖。"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_ref",
        "recent_decisions"
      ],
      "description": "记忆外置（DESIGN §3.2）：持久记忆是 Ledger 的决定日志，不是会话。换会话/重启/换模型，记忆不丢。",
      "properties": {
        "ledger_ref": {
          "type": "string",
          "pattern": "^/[^\\s]+$",
          "description": "Ledger 文件绝对路径。coordinator 可读、只走只读接口。"
        },
        "recent_decisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "快照里带了几条最近决定（上限 10）。人问『为什么这么派』时它读这里回答。"
        }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_prompt_ref",
        "output_contract"
      ],
      "description": "这次 turn 的输入约定。角色提示词是 templates/coordinator.md（从 shepherdr 的 assistant.md 改）。",
      "properties": {
        "role_prompt_ref": {
          "type": "string",
          "pattern": "^/[^\\s]+$",
          "description": "coordinator 角色提示词路径（安装后落在 ~/.config/herdr-core/templates/）。"
        },
        "output_contract": {
          "const": "urn:collie:decision:v1",
          "description": "coordinator 必须回一个 Decision（或一组 Decision action）。冻结为 Decision schema 的 $id：产出形状不可协商，换 schema 就是换协议版本。"
        }
      }
    },
    "message": {
      "$ref": "urn:collie:message:v1",
      "description": "被判断的 Message；正文在 data_ref，不在 Case 中复制。"
    }
  }
}
