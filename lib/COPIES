# Shared modules: lib/<file> is the source, copied by bin/collie-sync into each mod listed.
# A mod can only import files in its own folder, so each needs its own copy.
# core/<file>: the shared core (core/ beside lib/), copied to mods/<mod>/core/<file>.
# ui.js: collie-tabs / collie-chrome / collie-settings still use the shepherdr-shaped UI
#   (openSettings -> mods/shepherdr-settings); de-shepherdr it in lib/ui.js, not in a copy.
inbox-queue.js: collie
ticket-dot.js: collie
artview.js: collie collie-artifacts collie-chat
inbox-settings.js: collie-settings
ui.js: collie collie-tabs collie-chrome collie-settings collie-artifacts collie-chat
core/task-artifacts.js: collie collie-artifacts collie-chat
core/spaces.js: collie collie-tabs collie-chat
