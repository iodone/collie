#!/usr/bin/env python3
"""Per-space coordinator lifecycle: adopt, ensure, resume and explicit stop."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import time
import importlib.util
import sys

HOME = Path.home()
STATE = HOME / ".local/state/collie"
RUNTIME = STATE / "coordinator-runtime.json"
LOCK = STATE / "coordinator-runtime.lock"
LAUNCHER = HOME / ".config/herdr-app/bin/collie-terminal"
REPO = Path(__file__).resolve().parent.parent
if not (REPO / "plugins/agent/revive.py").is_file():
    REPO = HOME / ".local/share/collie"
sys.path.insert(0, str(HOME / ".config/herdr-app/mods/tasks/bin"))
spec = importlib.util.spec_from_file_location("inbox_revive", REPO / "plugins/agent/revive.py")
revive = importlib.util.module_from_spec(spec)
spec.loader.exec_module(revive)


def native_args(space, session=None):
    settings_path = STATE / "coordinator.json"
    settings = json.loads(settings_path.read_text()) if settings_path.is_file() else {}
    config = {**settings.get("everywhere", {}).get("coordinator", {}),
              **settings.get("spaces", {}).get(space, {}).get("coordinator", {})}
    cli = config.get("cli")
    if cli not in ("codex", "claude"):
        raise RuntimeError("coordinator is not configured")
    role = HOME / ".config/herdr-core/templates/collie-coordinator.md"
    prompt = role.read_text()
    model, effort = config.get("model"), config.get("effort")
    if cli == "codex":
        args = [cli, "--no-daemon", "--sandbox", "read-only"]
        if model and model != "default":
            args += ["--model", model]
        if effort:
            args += ["-c", f'model_reasoning_effort="{effort}"']
        if session:
            args += ["resume", session]
    else:
        args = [cli, "--permission-mode", "plan"]
        if model and model != "default":
            args += ["--model", model]
        if effort:
            args += ["--effort", effort]
        if session:
            args += ["--resume", session]
    return [*args, prompt]


def run(args):
    return subprocess.run(args, text=True, capture_output=True, timeout=30)


def load():
    if RUNTIME.is_file():
        return json.loads(RUNTIME.read_text())
    return {"version": 1, "spaces": {}}


def save(data):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = RUNTIME.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, RUNTIME)


def live(space):
    result = run(["hc", "ls", "--json"])
    if result.returncode:
        return []
    terminals = json.loads(result.stdout).get("terminals", [])
    detailed = []
    for terminal in terminals:
        shown = run(["hc", "get", terminal["address"], "--json"])
        if shown.returncode:
            continue
        value = {**terminal, **json.loads(shown.stdout)}
        if value.get("state") == "live" and value.get("labels", {}).get("herdr.role") == "coordinator" \
                and value.get("labels", {}).get("herdr.coordinator.space") == space \
                and value.get("labels", {}).get("herdr.inbox") == "true":
            detailed.append(value)
    return detailed


def children(pid):
    result = run(["pgrep", "-P", str(pid)])
    out = []
    for child in result.stdout.split():
        out.append(child)
        out.extend(children(child))
    return out


def session_of(pid):
    for current in [str(pid), *children(pid)]:
        claude = HOME / ".claude" / "sessions" / f"{current}.json"
        if claude.is_file():
            try:
                sid = json.loads(claude.read_text()).get("sessionId")
                if sid:
                    return sid
            except (OSError, ValueError):
                pass
        result = run(["lsof", "-p", current, "-Fn"])
        for line in result.stdout.splitlines():
            match = re.search(r"rollout-.*?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$", line)
            if match:
                return match.group(1)
    return None


def record_session(record):
    address = record.get("terminal")
    if not address:
        return
    shown = run(["hc", "get", address, "--json"])
    if shown.returncode:
        return
    foreground = json.loads(shown.stdout).get("foreground") or {}
    pid = foreground.get("pid") or json.loads(shown.stdout).get("pid")
    if pid:
        session = session_of(pid)
        if session:
            record["session"] = session


def ensure(space, start=True):
    with LOCK.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load()
        record = data["spaces"].setdefault(space, {"enabled": True, "state": "stopped", "retry_after": 0})
        report = {}
        revive.revive_pass(report)
        existing = live(space)
        if existing:
            record.update(terminal=existing[0]["address"], state="running", retry_after=0, failures=0)
            record_session(record)
            save(data)
            return record
        if not record.get("enabled", False):
            record["state"] = "stopped"
            save(data)
            return record
        now = time.time()
        if record.get("retry_after", 0) > now:
            save(data)
            return record
        args = ["herdr-app", "do", "tab.new", "--name", "Coordinator",
                "--argv", json.dumps(native_args(space, record.get("session")))]
        result = run(args)
        if result.returncode:
            failures = int(record.get("failures", 0)) + 1
            record.update(state="degraded", failures=failures,
                          retry_after=now + min(300, 5 * (2 ** min(failures, 5))),
                          error=(result.stderr or result.stdout).strip()[:500])
        else:
            out = json.loads(result.stdout)
            if out.get("terminal"):
                run(["hc", "label", out["terminal"], "herdr.role=coordinator", "herdr.inbox=true",
                     f"herdr.coordinator.space={space}"])
            record.update(terminal=out.get("terminal"), state="running", error=None, retry_after=0, failures=0)
        save(data)
        return record


def stop(space):
    data = load()
    record = data["spaces"].setdefault(space, {})
    record.update(enabled=False, state="stopped", retry_after=0)
    address = record.get("terminal")
    if address:
        run(["hc", "kill", address])
    record["terminal"] = None
    save(data)
    return record


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["ensure", "stop", "status"])
    parser.add_argument("--space", required=True)
    args = parser.parse_args()
    if args.action == "ensure":
        result = ensure(args.space)
    elif args.action == "stop":
        result = stop(args.space)
    else:
        result = load()["spaces"].get(args.space, {"enabled": False, "state": "stopped"})
    print(json.dumps(result, sort_keys=True))


if __name__ == "__main__":
    main()
