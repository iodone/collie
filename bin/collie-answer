#!/usr/bin/env bun
import { execFile } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { request } from "node:http";
import { promisify } from "node:util";

const execFileAsync = promisify(execFile);
const args = process.argv.slice(2);
const value = (name: string) => args[args.indexOf(name) + 1];
const stateDir = value("--state-dir") ?? join(homedir(), ".local", "state", "collie");
const decisionId = value("--decision");
const option = value("--option");
if (!decisionId || !["accept", "rework", "drop", "later"].includes(option)) {
  console.error("usage: collie-answer --decision ID --option accept|rework|drop|later [--file PATH --line N --note TEXT]");
  process.exit(2);
}
const answer: Record<string, unknown> = {
  option, at: new Date().toISOString(), by: "human",
};
if (option === "rework") {
  const note = value("--note");
  if (!note) throw new Error("rework requires --note");
  answer.annotations = [{ file: value("--file") ?? "review", note, ...(value("--line") ? { line: Number(value("--line")) } : {}) }];
}
if (option === "later") answer.snooze_until = value("--snooze") ?? null;

let coordinatorAddress: string | undefined;
if (option === "accept" || option === "rework") {
  const queue = JSON.parse(readFileSync(join(stateDir, "queue.json"), "utf8"));
  const decision = queue.decisions.find((item: any) => item.id === decisionId);
  if (!decision) throw new Error(`unknown decision ${decisionId}`);
  const workspacesPath = join(stateDir, "workspaces.json");
  const workspaces = existsSync(workspacesPath) ? JSON.parse(readFileSync(workspacesPath, "utf8")) : {};
  const folder = workspaces[decision.space]?.folder;
  if (!folder) throw new Error(`no workspace configured for ${decision.space}`);
  const { stdout } = await execFileAsync("herdr-task", ["assistants", "--json"]);
  const assistants = JSON.parse(stdout);
  const matches = assistants.filter((item: any) => item.folder === folder);
  if (matches.length !== 1) throw new Error(`expected one coordinator for ${decision.space}, got ${matches.length}`);
  coordinatorAddress = matches[0].address;
}

const result = await new Promise<string>((resolve, reject) => {
  const req = request({
    socketPath: join(stateDir, "service.sock"), path: "/answer", method: "POST",
    headers: { "content-type": "application/json" },
  }, (res) => {
    let body = "";
    res.on("data", (chunk) => { body += chunk; });
    res.on("end", () => res.statusCode === 200 ? resolve(body) : reject(new Error(body)));
  });
  req.on("error", reject);
  req.end(JSON.stringify({ decisionId, answer, coordinatorAddress }));
});
console.log(result);
