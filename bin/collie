#!/usr/bin/env python3
"""Offline, manifest-driven installer for the collie add-on."""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import socket
import stat
import subprocess
import sys
import tempfile

NAME = "collie"
APP = Path(".config/herdr-app")
CORE = Path(".config/herdr-core")
STATE = Path(".local/state/collie")
RUNTIME = Path(".local/share/collie")
HELPERS = Path(".local/bin")
SOURCE = Path(__file__).resolve().parent.parent
# Herdr ships these; collie's layout may name them but must not install or doctor them.
HERDR_MODS = {"pane", "spaces", "workspace-chrome", "workspace-status"}


class InstallError(Exception):
    pass


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_json(path: Path):
    try:
        with path.open(encoding="utf-8") as stream:
            return json.load(stream)
    except (OSError, json.JSONDecodeError) as exc:
        raise InstallError(f"cannot read JSON {path}: {exc}") from exc


def app_root(root: Path) -> Path:
    return root / APP


def target_path(root: Path, rel: str | Path) -> Path:
    relative = Path(rel)
    if not relative.parts or relative.is_absolute() or ".." in relative.parts:
        raise InstallError(f"unsafe installation path: {relative}")
    path = root
    for part in relative.parts:
        path = path / part
        if path.is_symlink():
            raise InstallError(f"refusing to follow symlink in installation root: {path}")
    return path


def validate_root(root: Path) -> None:
    for relative in (APP, CORE, STATE, RUNTIME, HELPERS):
        target_path(root, relative)


def manifest_path(root: Path) -> Path:
    return target_path(root, APP / "installed.collie.json")


def load_manifest(root: Path, required: bool = False) -> dict:
    path = manifest_path(root)
    if not path.exists():
        if required:
            raise InstallError(f"not installed at {root}; missing {path}")
        return {"schema": 1, "name": NAME, "files": {}, "modes": {}, "owned_keys": {}}
    data = read_json(path)
    if data.get("name") != NAME or not isinstance(data.get("files"), dict):
        raise InstallError(f"{path} is not a {NAME} manifest; refusing to modify it")
    return data


def source_files(source: Path, root: Path) -> dict[str, Path]:
    """Return home-relative destinations without enumerating individual mods."""
    files: dict[str, Path] = {}

    def add_tree(directory: str, destination: Path) -> None:
        base = source / directory
        if not base.is_dir():
            return
        for path in sorted(base.rglob("*")):
            if path.is_file() and not path.is_symlink() and "__pycache__" not in path.parts and ".last" not in path.parts and path.suffix != ".pyc":
                rel = path.relative_to(base)
                files[(destination / rel).as_posix()] = path

    for directory in ("layouts", "mods", "lib", "core"):
        add_tree(directory, APP / directory)
    for directory in ("kernel", "plugins", "service", "protocol", "vendor"):
        add_tree(directory, RUNTIME / directory)
    add_tree("templates", CORE / "templates")
    ruleset = source / "protocol/fixtures/ruleset.json"
    if ruleset.is_file():
        files[(STATE / "ruleset.json").as_posix()] = ruleset
    for name in ("collie", "collie-sync", "collie-answer", "collie-request", "collie-task", "collie-secret"):
        path = source / "bin" / name
        if path.is_file():
            files[(APP / "bin" / name).as_posix()] = path
    for name in ("collie-sync", "collie-task", "collie-secret"):
        helper = source / "bin" / name
        if helper.is_file():
            files[(HELPERS / name).as_posix()] = helper
    artifact = source / "mods/collie-artifacts/bin/collie-artifact"
    if artifact.is_file():
        files[(APP / "bin" / "collie-artifact").as_posix()] = artifact
        files[(HELPERS / "collie-artifact").as_posix()] = artifact
    addon = source / "addons.json"
    if not addon.is_file():
        raise InstallError(f"missing {addon}")
    files[(APP / "lib" / "addons" / f"{NAME}.json").as_posix()] = addon
    return files


def atomic_write(path: Path, data: bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def write_json(path: Path, data, mode: int = 0o644) -> None:
    atomic_write(path, (json.dumps(data, indent=2, sort_keys=True) + "\n").encode(), mode)


def backup_name(rel: str) -> Path:
    path = Path(rel)
    try:
        return path.relative_to(APP)
    except ValueError:
        return Path("external") / path


class Backups:
    def __init__(self, root: Path, dry_run: bool):
        self.directory = app_root(root) / ".collie-backup" / dt.datetime.now(
            dt.timezone.utc
        ).strftime("%Y%m%dT%H%M%S%fZ")
        self.dry_run = dry_run

    def save(self, root: Path, rel: str) -> None:
        source = root / rel
        if not source.is_file():
            return
        destination = self.directory / backup_name(rel)
        target_path(root, destination.relative_to(root))
        print(f"backup {source} -> {destination}")
        if not self.dry_run:
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)


def dependency_errors(root: Path, source: Path) -> list[str]:
    errors = []
    for command in ("bun", "git"):
        if not shutil.which(command):
            errors.append(f"missing dependency `{command}`; install bun and git first")
    bundled = source / "vendor/herdr-task"
    if not (bundled / "herdr_task/cli.py").is_file():
        errors.append(f"missing dependency `collie-task`; no vendored herdr_task package at {bundled}")
    if not (source / "bin/collie-task").is_file():
        errors.append(f"missing dependency `collie-task`; no wrapper at {source / 'bin/collie-task'}")
    addons = read_json(source / "addons.json")
    needs = addons.get("needs", {})
    if isinstance(needs, list):
        needs = {name: "" for name in needs}
    if not isinstance(needs, dict):
        raise InstallError("addons.json `needs` must be an object or list")
    for mod, requirement in needs.items():
        if not (app_root(root) / "mods" / mod).is_dir():
            errors.append(f"missing required mod `{mod}` at {app_root(root) / 'mods' / mod}")
    return errors


def confirm(message: str, yes: bool) -> None:
    if yes:
        return
    try:
        answer = input(f"{message} [y/N] ").strip().lower()
    except EOFError as exc:
        raise InstallError("confirmation required; rerun with --yes") from exc
    if answer not in ("y", "yes"):
        raise InstallError("cancelled")


def key_plan(root: Path, source: Path, policy: str, yes: bool) -> tuple[dict, dict, bool]:
    path = target_path(root, APP / "keys.json")
    existing = read_json(path) if path.is_file() else {}
    desired = read_json(source / "addons.json").get("keys", {})
    if not isinstance(existing, dict) or not isinstance(desired, dict):
        raise InstallError("keys.json and addons.json `keys` must be objects")
    merged = dict(existing)
    owned = {}
    changed = False
    for key, value in desired.items():
        if key not in existing:
            merged[key] = value
            owned[key] = value
            changed = True
        elif existing[key] == value:
            owned[key] = value
        else:
            choice = policy
            if choice == "ask":
                if yes:
                    raise InstallError(f"key `{key}` conflicts; choose --keys keep or --keys ours")
                try:
                    choice = {"k": "keep", "o": "ours"}.get(
                        input(f"key `{key}` exists; [k]eep or [o]urs? ").strip().lower(), ""
                    )
                except EOFError as exc:
                    raise InstallError("key conflict needs a choice") from exc
                if not choice:
                    raise InstallError("key conflict needs `k` or `o`")
            if choice == "ours":
                merged[key] = value
                owned[key] = value
                changed = True
    return merged, owned, changed


def build_plan(root: Path, source: Path, adopt: bool):
    old = load_manifest(root)
    files = source_files(source, root)
    old_files = old.get("files", {})
    plans = []
    for rel, origin in sorted(files.items()):
        target = target_path(root, rel)
        incoming = sha256(origin)
        previous = old_files.get(rel)
        if not target.exists():
            action = "install"
        else:
            if not target.is_file():
                raise InstallError(f"target is not a regular file: {target}")
            current = sha256(target)
            if current == incoming:
                action = "unchanged"
            elif previous and current == previous:
                action = "replace"
            elif previous:
                action = "modified"
            elif adopt:
                action = "adopt"
            else:
                raise InstallError(f"unmanaged file differs: {target}; use --adopt to take ownership")
        plans.append({"rel": rel, "source": origin, "sha256": incoming, "action": action})
    for rel, previous in sorted(old_files.items()):
        if rel in files:
            continue
        target = target_path(root, rel)
        action = "remove"
        if target.exists() and (not target.is_file() or sha256(target) != previous):
            action = "stale-modified"
        plans.append({"rel": rel, "source": None, "sha256": previous, "action": action})
    return old, plans


def print_plan(root: Path, plans: list[dict]) -> None:
    for item in plans:
        suffix = " (kept; incoming is .new)" if item["action"] == "modified" else ""
        print(f"{item['action']:15} {target_path(root, item['rel'])}{suffix}")



HOOK_FILES = (".claude/settings.json", ".codex/hooks.json")
# collie-chat's hooks: the permission card (a permission, question or plan answered on the agent's
# chat), and the note a session starts with (how reactions travel, an Assistant's settings).
CHAT_HOOKS = (("PermissionRequest", "ask-hook.sh", 1800), ("SessionStart", "session-note.sh", 10))


def add_hooks(root: Path) -> list[list[str]]:
    """Point Claude/Codex at collie-chat's hooks, once: its permission card and its session note."""
    done: list[list[str]] = []
    for relative in HOOK_FILES:
        path = target_path(root, relative)
        if not path.parent.is_dir():
            continue
        try:
            data = json.loads(path.read_text()) if path.exists() else {}
        except ValueError:
            print(f"hooks: {path} is not valid JSON; left alone", file=sys.stderr)
            continue
        changed = False
        for event, script, timeout in CHAT_HOOKS:
            command = f"sh '{app_root(root)}/mods/collie-chat/{script}'"
            entries = data.setdefault("hooks", {}).setdefault(event, [])
            done.append([relative, event, command])
            # Drop the same hook written by an older Shepherdr install (mods/chat/<script>).
            kept = []
            for entry in entries:
                hooks = entry.get("hooks", [])
                live = [h for h in hooks if f"/mods/chat/{script}" not in h.get("command", "")]
                if len(live) != len(hooks):
                    changed = True
                    if live:
                        entry["hooks"] = live
                        kept.append(entry)
                else:
                    kept.append(entry)
            entries[:] = kept
            if any(script in hook.get("command", "") for entry in entries for hook in entry.get("hooks", [])):
                continue
            entries.append({"hooks": [{"type": "command", "command": command, "timeout": timeout}]})
            changed = True
        if changed:
            if path.exists():
                Backups(root, False).save(root, relative)
            path.parent.mkdir(parents=True, exist_ok=True)
            atomic_write(path, (json.dumps(data, indent=2) + "\n").encode())
            if relative.startswith(".codex"):
                print("hooks: Codex asks once to trust its new hook; approve it in its Hooks screen")
    return done


def remove_hooks(root: Path, dry_run: bool) -> None:
    scripts = [script for _, script, _ in CHAT_HOOKS]
    for relative in HOOK_FILES:
        path = target_path(root, relative)
        if not path.exists():
            continue
        try:
            data = json.loads(path.read_text())
        except ValueError:
            continue
        changed = False
        for event, entries in list((data.get("hooks") or {}).items()):
            kept = [entry for entry in entries
                    if not any(f"/mods/collie-chat/{script}" in hook.get("command", "") for script in scripts for hook in entry.get("hooks", []))]
            if len(kept) != len(entries):
                changed = True
                if kept:
                    data["hooks"][event] = kept
                else:
                    del data["hooks"][event]
        if changed:
            print(f"remove hook     {path}")
            if not dry_run:
                Backups(root, False).save(root, relative)
                if data.get("hooks"):
                    atomic_write(path, (json.dumps(data, indent=2) + "\n").encode())
                else:
                    path.unlink()


def install(args, source_override: Path | None = None) -> int:
    root = args.root.expanduser().resolve()
    validate_root(root)
    source = (source_override or SOURCE).expanduser().resolve()
    errors = dependency_errors(root, source)
    if errors:
        raise InstallError("dependency check failed:\n  " + "\n  ".join(errors))
    old, plans = build_plan(root, source, args.adopt)
    merged_keys, owned_keys, keys_changed = key_plan(root, source, args.keys, args.yes)
    print(f"source: {source}\nroot:   {root}")
    print_plan(root, plans)
    if keys_changed:
        print(f"update keys     {app_root(root) / 'keys.json'}")
    if args.dry_run:
        print("dry-run: no files changed")
        return 0
    confirm(f"Install {sum(p['action'] != 'unchanged' for p in plans)} planned file changes?", args.yes)
    backups = Backups(root, False)
    manifest = {
        "schema": 1,
        "name": NAME,
        "version": read_json(source / "addons.json").get("version", "0.0.0"),
        "source": str(source),
        "files": {},
        "modes": {},
        "owned_keys": owned_keys,
    }
    for item in plans:
        rel = item["rel"]
        target = target_path(root, rel)
        action = item["action"]
        if action == "stale-modified":
            manifest["files"][rel] = item["sha256"]
            if rel in old.get("modes", {}):
                manifest["modes"][rel] = old["modes"][rel]
            continue
        if action == "remove":
            backups.save(root, rel)
            if target.exists():
                target.unlink()
            continue
        origin = item["source"]
        mode = stat.S_IMODE(origin.stat().st_mode)
        manifest["files"][rel] = item["sha256"]
        manifest["modes"][rel] = mode
        if action in ("replace", "adopt", "remove"):
            backups.save(root, rel)
        if action == "modified":
            new = target.with_name(target.name + ".new")
            atomic_write(new, origin.read_bytes(), mode)
        elif action != "unchanged":
            atomic_write(target, origin.read_bytes(), mode)
        elif target.stat().st_mode & 0o777 != mode:
            target.chmod(mode)
    if keys_changed:
        backups.save(root, (APP / "keys.json").as_posix())
        write_json(app_root(root) / "keys.json", merged_keys)
    manifest["hooks"] = add_hooks(root)
    if manifest_path(root).exists():
        backups.save(root, manifest_path(root).relative_to(root).as_posix())
    target_path(root, STATE).mkdir(parents=True, exist_ok=True, mode=0o700)
    write_json(manifest_path(root), manifest)
    print(f"manifest: {manifest_path(root)}")
    return doctor(args)


def update(args) -> int:
    root = args.root.expanduser().resolve()
    validate_root(root)
    installed = load_manifest(root, required=True)
    source = installed.get("source")
    if not source or not Path(source).is_dir():
        raise InstallError(f"original source checkout is unavailable: {source!r}")
    return install(args, Path(source))


def layout_mods(value) -> set[str]:
    found = set()
    if isinstance(value, dict):
        for key, child in value.items():
            if key == "mod" and isinstance(child, str):
                found.add(child)
            else:
                found.update(layout_mods(child))
    elif isinstance(value, list):
        for child in value:
            found.update(layout_mods(child))
    return found


def without_dynamic_terminals(value):
    """A layout's runtime terminal blocks (ticket/helper) are added by mods, not source."""
    if isinstance(value, list):
        return [without_dynamic_terminals(item) for item in value]
    if not isinstance(value, dict):
        return value
    if isinstance(value.get("content"), dict) and "terminal" in value["content"]:
        return None
    out = {}
    for key, item in value.items():
        if key == "children" and isinstance(item, list):
            out[key] = [clean for child in item if (clean := without_dynamic_terminals(child)) is not None]
        else:
            out[key] = without_dynamic_terminals(item)
    return out


def doctor(args) -> int:
    root = args.root.expanduser().resolve()
    validate_root(root)
    failures = []

    def check(ok: bool, message: str) -> None:
        print(f"{'OK  ' if ok else 'FAIL'} {message}")
        if not ok:
            failures.append(message)

    try:
        manifest = load_manifest(root, required=True)
        check(True, "manifest is readable")
    except InstallError as exc:
        check(False, str(exc))
        print("doctor: 1 check failed")
        return 1
    try:
        dependency_failures = dependency_errors(root, Path(manifest.get("source", SOURCE)))
    except InstallError as exc:
        dependency_failures = [str(exc)]
    for error in dependency_failures:
        check(False, error)
    if not dependency_failures:
        check(True, "bundled collie-task, bun and git")
    source = Path(manifest.get("source", ""))
    check(source.is_dir(), f"source checkout exists: {source}")
    check((root / STATE).is_dir(), f"state directory exists: {root / STATE}")
    check(target_path(root, RUNTIME / "service/main.ts").is_file(), "background service entry is installed")
    check(
        target_path(root, RUNTIME / "vendor/herdr-task/herdr_task/cli.py").is_file(),
        "vendored task package is installed",
    )
    try:
        read_json(target_path(root, STATE / "ruleset.json"))
        check(True, "initial ruleset is valid JSON")
    except InstallError as exc:
        check(False, str(exc))
    source = Path(manifest.get("source", ""))
    for rel, expected in sorted(manifest.get("files", {}).items()):
        path = target_path(root, rel)
        if not path.is_file():
            check(False, f"missing {path}")
        elif rel.startswith(".config/herdr-app/layouts/"):
            # Mods add terminal blocks to a layout at runtime (ticket Terminal, helper pane).
            # Compare the authored layout, not those generated blocks.
            current = read_json(path)
            authored_path = source / rel.replace(".config/herdr-app/", "", 1)
            authored = read_json(authored_path) if authored_path.is_file() else None
            layout_ok = without_dynamic_terminals(current) == without_dynamic_terminals(authored)
            check(layout_ok, f"layout structure {rel}")
            pending = path.with_name(path.name + ".new")
            if pending.exists() and not layout_ok:
                check(False, f"pending update requires review: {pending}")
            continue
        elif sha256(path) != expected:
            check(False, f"modified {path}")
        else:
            check(True, rel)
        pending = path.with_name(path.name + ".new")
        if pending.exists():
            check(False, f"pending update requires review: {pending}")
    for rel, mode in manifest.get("modes", {}).items():
        path = target_path(root, rel)
        if mode & stat.S_IXUSR and path.is_file():
            check(os.access(path, os.X_OK), f"executable {path}")
    addons_path = app_root(root) / "lib/addons" / f"{NAME}.json"
    try:
        read_json(addons_path)
        check(True, "add-on metadata is valid JSON")
        layout = read_json(app_root(root) / "layouts/collie.json")
        for mod in sorted(layout_mods(layout) - HERDR_MODS):
            check((app_root(root) / "mods" / mod).is_dir(), f"layout mod `{mod}` is installed")
    except InstallError as exc:
        check(False, str(exc))
    if failures:
        print(f"doctor: {len(failures)} check(s) failed")
        return 1
    print("doctor: all checks passed")
    return 0


def remove_empty_parents(path: Path, stop: Path, preserve: Path) -> None:
    while path != stop and path != preserve and path.is_dir():
        try:
            path.rmdir()
        except OSError:
            break
        path = path.parent



def service_unit(root: Path, bun: str, main: Path) -> tuple[Path, str]:
    state = target_path(root, STATE)
    log = state / "service.log"
    if sys.platform == "darwin":
        label = "dev.collie.service"
        path = Path("Library/LaunchAgents") / f"{label}.plist"
        path_text = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key><array><string>{bun}</string><string>{main}</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>{root}</string>
    <key>HERDR_INBOX_STATE</key><string>{state}</string>
    <key>PATH</key><string>{root}/.local/bin:{root}/.config/herdr-app/bin:{Path(bun).parent}:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{log}</string>
  <key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
"""
    else:
        path = Path(".config/systemd/user/collie.service")
        path_text = f"""[Unit]
Description=Collie background service
After=network-online.target

[Service]
ExecStart={bun} {main}
Environment=HOME={root}
Environment=HERDR_INBOX_STATE={state}
Environment=PATH={root}/.local/bin:{root}/.config/herdr-app/bin:{Path(bun).parent}:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
"""
    return path, path_text


def service_control(root: Path, action: str) -> int:
    if root != Path.home():
        print(f"collie service unit belongs to {root}; run {action} in that HOME", file=sys.stderr)
        return 0
    if sys.platform == "darwin":
        label = f"gui/{os.getuid()}/dev.collie.service"
        command = ["launchctl", "kickstart", "-k", label] if action == "start" else ["launchctl", "bootout", label]
    else:
        command = ["systemctl", "--user", action, "collie.service"]
    result = subprocess.run(command)
    return result.returncode


def service_install(args) -> int:
    root = args.root.expanduser().resolve()
    validate_root(root)
    bun = shutil.which("bun")
    if not bun:
        raise InstallError("bun is required for collie service")
    main = target_path(root, RUNTIME / "service/main.ts")
    if not main.is_file():
        raise InstallError(f"missing service entry: {main}")
    relative, text = service_unit(root, bun, main)
    path = target_path(root, relative)
    if args.dry_run:
        print(f"would write {path}")
        return 0
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(path, text.encode(), 0o644)
    print(path)
    if root != Path.home():
        return 0
    if sys.platform == "darwin":
        target = f"gui/{os.getuid()}"
        subprocess.run(["launchctl", "bootout", f"{target}/dev.collie.service"], capture_output=True)
        return subprocess.run(["launchctl", "bootstrap", target, str(path)]).returncode
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    return subprocess.run(["systemctl", "--user", "enable", "--now", "collie.service"]).returncode


def service_uninstall(args) -> int:
    root = args.root.expanduser().resolve()
    validate_root(root)
    bun = shutil.which("bun") or "bun"
    main = target_path(root, RUNTIME / "service/main.ts")
    relative, _ = service_unit(root, bun, main)
    path = target_path(root, relative)
    if root == Path.home():
        service_control(root, "stop")
    if path.exists() and not args.dry_run:
        path.unlink()
    print(path)
    return 0

def service_health(root: Path):
    socket_path = target_path(root, STATE / "service.sock")
    if not socket_path.exists():
        return False, {"error": f"collie service is not running (no socket at {socket_path})"}
    import socket
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(3)
    try:
        client.connect(str(socket_path))
        client.sendall(b"GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
        chunks = []
        while True:
            chunk = client.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
    except OSError as exc:
        return False, {"error": f"collie service did not answer: {exc}"}
    finally:
        client.close()
    raw = b"".join(chunks)
    head, _, body = raw.partition(b"\r\n\r\n")
    if b" 200 " not in head.split(b"\r\n", 1)[0]:
        return False, {"error": f"collie service health failed: {head.decode(errors='replace')}"}
    try:
        return True, json.loads(body or b"{}")
    except ValueError:
        return False, {"error": "collie service returned invalid JSON"}


def service_start(args) -> int:
    return service_control(args.root.expanduser().resolve(), "start")


def service_stop(args) -> int:
    return service_control(args.root.expanduser().resolve(), "stop")


def service_status(args) -> int:
    root = args.root.expanduser().resolve()
    ok, result = service_health(root)
    if not ok:
        print(result["error"], file=sys.stderr)
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    return 0


def status(args) -> int:
    root = args.root.expanduser().resolve()
    ok, service = service_health(root)
    try:
        core_result = subprocess.run(["hc", "server", "status"], capture_output=True, text=True, timeout=10)
        core = json.loads(core_result.stdout) if core_result.returncode == 0 else None
    except (OSError, ValueError, subprocess.SubprocessError):
        core = None
    app = None
    try:
        app_result = subprocess.run(["herdr-app", "status"], capture_output=True, text=True, timeout=10)
        app = json.loads(app_result.stdout) if app_result.returncode == 0 else None
    except (OSError, ValueError, subprocess.SubprocessError):
        app = None
    coordinators = []
    try:
        listed = subprocess.run(["hc", "ls", "--json"], capture_output=True, text=True, timeout=10)
        terminals = json.loads(listed.stdout).get("terminals", []) if listed.returncode == 0 else []
        for terminal in terminals:
            labels = terminal.get("labels") or {}
            if labels.get("herdr.role") == "coordinator" or labels.get("herdr.inbox") == "true":
                coordinators.append({
                    "address": terminal.get("address"),
                    "state": terminal.get("state"),
                    "space": labels.get("herdr.coordinator.space") or labels.get("herdr.space"),
                })
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    print(json.dumps({
        "root": str(root),
        "service": service if ok else {"running": False, **service},
        "core": core,
        "app": app,
        "coordinators": coordinators,
    }, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


def uninstall(args) -> int:
    root = args.root.expanduser().resolve()
    validate_root(root)
    manifest = load_manifest(root, required=True)
    if not args.dry_run:
        confirm("Uninstall collie?", args.yes)
    remaining = {}
    for rel, expected in sorted(manifest.get("files", {}).items()):
        path = target_path(root, rel)
        if path.exists() and (not path.is_file() or sha256(path) != expected):
            print(f"keep modified   {path}")
            remaining[rel] = expected
            continue
        print(f"remove          {path}")
        if not args.dry_run and path.exists():
            path.unlink()
            remove_empty_parents(path.parent, root, target_path(root, STATE))
        pending = path.with_name(path.name + ".new")
        if pending.exists():
            print(f"remove pending  {pending}")
            if not args.dry_run:
                pending.unlink()
    keys_path = target_path(root, APP / "keys.json")
    keys = read_json(keys_path) if keys_path.is_file() else {}
    keys_changed = False
    for key, value in manifest.get("owned_keys", {}).items():
        if keys.get(key) == value:
            print(f"remove key      {key}")
            if not args.dry_run:
                del keys[key]
                keys_changed = True
    remove_hooks(root, args.dry_run)
    if args.dry_run:
        print("dry-run: no files changed")
        return 0
    if keys_changed:
        write_json(keys_path, keys)
    if remaining:
        manifest["files"] = remaining
        manifest["modes"] = {key: value for key, value in manifest.get("modes", {}).items() if key in remaining}
        manifest["owned_keys"] = {}
        write_json(manifest_path(root), manifest)
        print("modified files remain; backups and state were not removed")
    else:
        manifest_path(root).unlink(missing_ok=True)
        print("uninstalled; backups and state were not removed")
    return 0


class _UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, socket_path: Path):
        super().__init__("localhost", timeout=20)
        self.socket_path = socket_path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(120)
        self.sock.connect(str(self.socket_path))


def _service_post(root: Path, route: str, payload: dict, state_dir: Path | None = None, headers: dict | None = None) -> dict:
    state = Path(state_dir).expanduser().resolve() if state_dir else target_path(root, STATE)
    socket_path = state / "service.sock"
    if not socket_path.exists():
        raise InstallError(f"collie service is not running (no socket at {socket_path})")
    body = json.dumps(payload).encode("utf-8")
    try:
        connection = _UnixHTTPConnection(socket_path)
        connection.request("POST", route, body=body, headers={"content-type": "application/json", "connection": "close", **(headers or {})})
        response = connection.getresponse()
        raw = response.read()
        status = response.status
        connection.close()
    except OSError as exc:
        raise InstallError(f"can't reach collie service: {exc}") from exc
    try:
        data = json.loads(raw.decode("utf-8") or "{}")
    except ValueError as exc:
        raise InstallError("collie service returned invalid JSON") from exc
    if status != 200:
        raise InstallError(str(data.get("error") or f"collie service returned {status}"))
    return data


def _service_get(root: Path, route: str, state_dir: Path | None = None) -> dict:
    state = Path(state_dir).expanduser().resolve() if state_dir else target_path(root, STATE)
    socket_path = state / "service.sock"
    if not socket_path.exists():
        raise InstallError(f"collie service is not running (no socket at {socket_path})")
    try:
        connection = _UnixHTTPConnection(socket_path)
        connection.request("GET", route, headers={"connection": "close"})
        response = connection.getresponse()
        raw = response.read()
        status = response.status
        connection.close()
    except OSError as exc:
        raise InstallError(f"can't reach collie service: {exc}") from exc
    try:
        data = json.loads(raw.decode("utf-8") or "{}")
    except ValueError as exc:
        raise InstallError("collie service returned invalid JSON") from exc
    if status != 200:
        raise InstallError(str(data.get("error") or f"collie service returned {status}"))
    return data


def roles_list(args) -> int:
    print(json.dumps(_service_get(args.root, "/v1/collaboration", args.state_dir), ensure_ascii=False))
    return 0


def ticket_create(args) -> int:
    space, title, source = args.space, args.title, args.brief
    if source == "-":
        brief = sys.stdin.read()
    else:
        brief = Path(source).read_text()
    payload = {"space": space, "title": title, "brief": brief, "kind": args.kind}
    if args.project:
        payload["project"] = args.project
    if args.playbook:
        payload["playbook"] = args.playbook
    result = _service_post(args.root, "/ticket", payload, args.state_dir)
    print(json.dumps(result, ensure_ascii=False))
    return 0


def decision_commit(args) -> int:
    raw = sys.stdin.read() if args.file == "-" else Path(args.file).read_text(encoding="utf-8")
    try:
        decision = json.loads(raw)
    except ValueError as exc:
        raise InstallError(f"invalid decision JSON: {exc}") from exc
    result = _service_post(args.root, "/decision", {
        "space": args.space, "project": args.project, "decision": decision,
    }, args.state_dir)
    print(json.dumps(result, ensure_ascii=False))
    return 0


def ticket_adopt(args) -> int:
    helper = target_path(args.root, APP / "bin" / "collie-task")
    if not helper.is_file():
        helper = Path(shutil.which("collie-task") or "")
    if not helper.is_file():
        raise InstallError("collie-task is not installed")
    shown = subprocess.run([str(helper), "show", args.task, "--folder", args.folder, "--json"],
                           text=True, capture_output=True)
    if shown.returncode != 0:
        raise InstallError(shown.stderr.strip() or f"can't read task {args.task}")
    try:
        task = json.loads(shown.stdout)
    except ValueError as exc:
        raise InstallError(f"collie-task returned invalid JSON") from exc
    task_ref = task.get("key") or task.get("ref")
    if not task_ref:
        raise InstallError(f"task {args.task} has no key/ref")
    result = _service_post(args.root, "/ticket/adopt", {
        "space": args.space, "task_ref": task_ref, "title": task.get("title") or args.task,
        "brief": task.get("prompt"), "kind": args.kind,
    }, args.state_dir)
    print(json.dumps(result, ensure_ascii=False))
    return 0


def ticket_show(args) -> int:
    queue_path = (Path(args.state_dir).expanduser().resolve() if args.state_dir else target_path(args.root, STATE)) / "queue.json"
    if not queue_path.is_file():
        raise InstallError(f"no queue at {queue_path}")
    queue = json.loads(queue_path.read_text())
    decision = next((item for item in queue.get("decisions", [])
                     if (args.decision and item.get("id") == args.decision)
                     or (args.ticket and item.get("run", {}).get("task_ref") == args.ticket)), None)
    if decision is None:
        raise InstallError(f"no decision for {args.decision or args.ticket}")
    print(json.dumps({
        "decision_id": decision.get("id"), "state": decision.get("state"), "space": decision.get("space"),
        "ticket_ref": decision.get("run", {}).get("task_ref"), "project": decision.get("project"),
        "playbook": (decision.get("playbook") or {}).get("id"), "kind": decision.get("run", {}).get("kind", "build"),
        "why": decision.get("why"),
    }, ensure_ascii=False))
    return 0



CLEAN_ENV = (
    "for v in $(env | sed -nE 's/^(CLAUDECODE|CLAUDE_PID|CLAUDE_CODE_[A-Za-z0-9_]+)=.*/\\1/p' "
    "| grep -vE '^CLAUDE_CODE_(USE|SKIP|DISABLE|ENABLE|MAX|OAUTH|CLIENT|API)_'); do unset \"$v\"; done;"
)


def _run(args, *, timeout=300, input_text=None):
    try:
        return subprocess.run(args, capture_output=True, text=True, input=input_text, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        raise InstallError(f"cannot run {args[0]}: {exc}") from exc


def _hc(*args, timeout=300, input_text=None, required=True):
    result = _run(["hc", *map(str, args)], timeout=timeout, input_text=input_text)
    if required and result.returncode != 0:
        raise InstallError((result.stderr or result.stdout or f"hc {args[0]} failed").strip())
    return result


def _hc_json(*args):
    result = _hc(*args)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise InstallError(f"hc {args[0]} returned invalid JSON") from exc


def _template(path: Path):
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None
    match = re.match(r"^---\n([\s\S]*?)\n---\n?", text)
    if not match:
        return "", text
    command = ""
    for line in match.group(1).splitlines():
        if line.startswith("command:"):
            command = line.split(":", 1)[1].strip()
            break
    return command, text[match.end():]


def _find_log(info: dict, old: str, app: str, pid: str, created: int, cwd: str, home: Path) -> str | None:
    if app == "claude-code" and pid:
        try:
            meta = json.loads((home / ".claude" / "sessions" / f"{pid}.json").read_text())
            sid = meta.get("sessionId")
            if sid:
                found = list((home / ".claude" / "projects").rglob(f"{sid}.jsonl"))
                if found:
                    return str(found[0])
        except (OSError, json.JSONDecodeError):
            pass
    if not created:
        return None
    roots = [home / ".claude" / "projects", home / ".codex" / "sessions",
             home / ".pi" / "agent" / "sessions", home / ".local" / "share" / "opencode"]
    candidates = []
    for root in roots:
        if not root.exists():
            continue
        for path in root.rglob("*"):
            if path.is_file() and path.suffix in {".jsonl", ".json"}:
                try:
                    if path.stat().st_mtime >= created / 1000 - 1:
                        if cwd.encode() in path.read_bytes():
                            candidates.append((path.stat().st_mtime, path))
                except OSError:
                    pass
    return str(max(candidates)[1]) if candidates else None



def _resume_argv(argv):
    """A resumed Claude session already has its system prompt; passing it again exits 129."""
    out, skip = [], False
    for value in argv:
        if skip:
            skip = False
            continue
        if value in {"--append-system-prompt", "--system-prompt"}:
            skip = True
            continue
        if value.startswith("--append-system-prompt=") or value.startswith("--system-prompt="):
            continue
        out.append(value)
    return out


def coordinator_restart(args) -> int:
    """Restart an agent in its tab; Coordinator stays parked behind its chat."""
    old = args.terminal
    if "/" in old:
        on, here = old.split("/", 1)
        remote = ["hc", "exec", "--on", on, "--timeout", "300", "--", "collie", "coordinator", "restart", here]
        if args.argv:
            remote += ["--argv", args.argv]
        if args.chat:
            remote += ["--chat", args.chat]
        if args.resume:
            remote.append("--resume")
        result = _run(remote, timeout=360)
        if result.returncode != 0:
            raise InstallError((result.stderr or result.stdout or f"{on} restart failed").strip())
        new = result.stdout.strip().splitlines()[-1] if result.stdout.strip() else ""
        if not new:
            raise InstallError(f"{on} returned no new terminal")
        print(f"{on}/{new}")
        return 0
    argv = json.loads(args.argv) if args.argv else []
    if not isinstance(argv, list) or not all(isinstance(x, str) for x in argv):
        raise InstallError("--argv must be a JSON array of strings")
    if args.resume:
        argv = _resume_argv(argv)
    home = Path.home()
    info = _hc_json("get", old, "--json")
    labels = info.get("labels") or {}
    space = labels.get("herdr.space") or ""
    tab = labels.get("herdr.tab") or labels.get("herdr.coordinator.tab") or ""
    role = labels.get("herdr.role") or ""
    if info.get("template") in ("assistant", "coordinator"):
        role = "coordinator"
    chat = args.chat or labels.get("herdr.chat") or ""
    if not ((space and tab) or chat):
        raise InstallError("the terminal has no space/tab or chat pane")
    cwd = info.get("cwd") or ""
    app = (info.get("status") or {}).get("app") or info.get("agent") or ""
    pid = str((info.get("foreground") or {}).get("pid") or "")
    created = int(info.get("created_ms") or 0)

    handoff_dir = Path(os.environ.get("HERDR_APP_HOME", home / ".config" / "herdr-app")) / "data" / "coordinator" / "handoff"
    handoff_dir.mkdir(parents=True, exist_ok=True)
    screen = handoff_dir / f"{old}-{int(dt.datetime.now().timestamp())}.txt"
    read = _hc("read", old, "--lines", "400", required=False)
    screen.write_text(read.stdout or "", encoding="utf-8")
    log = _find_log(info, old, app, pid, created, cwd, home)
    was = app or "the previous agent"
    handoff = f"You are taking over this tab from {was} ({old}), which was restarted."
    if log:
        handoff += f" Its session log is {log}: read the recent part to pick up where it left off."
    handoff += f" Its last screen is saved in {screen}."

    if role == "coordinator":
        workers = set()
        for term in _hc_json("ls", "--json").get("terminals", []):
            if term.get("parent") == old:
                workers.add(term.get("address"))
        for term in _hc_json("ls", "--json", "--label", f"herdr.coordinator={tab}").get("terminals", []):
            if term.get("address") != old:
                workers.add(term.get("address"))
        if workers:
            listed = []
            for worker in sorted(x for x in workers if x):
                _hc("label", worker, f"herdr.coordinator={tab}", required=False)
                item = _hc_json("get", worker, "--json")
                listed.append(f" {worker} ({item.get('name') or (item.get('labels') or {}).get('where') or ''})")
            handoff += (" Workers the previous coordinator started, still running:" + "".join(listed)
                        + f". They report to {old}: watch each with hc wait <t> and tell each to report to you from now on.")

    new_labels = ["--label", f"herdr.space={space}", "--label", f"herdr.tab={tab}"]
    if role == "coordinator":
        new_labels += ["--label", "herdr.role=coordinator"]
    if chat:
        origin = labels.get("herdr.chat.origin") or old
        new_labels = ["--keep", "--label", f"herdr.chat={chat}", "--label", f"herdr.chat.origin={origin}"]
        for key in ("herdr.chat.slot", "herdr.coordinator.space", "herdr.coordinator.tab"):
            if labels.get(key):
                new_labels += ["--label", f"{key}={labels[key]}"]
        if role == "coordinator":
            new_labels += ["--label", "herdr.role=coordinator"]

    tpl = home / ".config" / "herdr-core" / "templates" / "roles" / "coordinator.md"
    parsed = _template(tpl) or ("", "")
    own_command, body = parsed
    body = body.strip()

    if args.resume:
        if not argv:
            raise InstallError("--resume needs --argv")
        key = Path(argv[0]).name
        run = _hc("run", "--bg", "--json", "--no-parent", *(["--cwd", cwd] if cwd else []), *new_labels,
                  "--label", f"herdr.agent={key}", "--", "sh", "-c", CLEAN_ENV + ' exec "$@"', "herdr-clean", *argv)
        out = json.loads(run.stdout or "{}")
        new = out.get("address")
    elif not argv and role == "coordinator" and not own_command:
        run = _hc("run", "--bg", "--json", "--no-parent", *(["--cwd", cwd] if cwd else []), *new_labels, "collie-coordinator", handoff)
        new = (json.loads(run.stdout or "{}")).get("address")
    else:
        if not argv and not (role == "coordinator" and own_command):
            raise InstallError("nothing to restart: pass --argv")
        if own_command and not argv:
            line = own_command[5:].strip() if own_command.startswith("exec ") else own_command.strip()
            key = Path(line.split()[0]).name
        else:
            line = shlex.join(argv)
            key = Path(argv[0]).name
            if key == "codex" and "--no-daemon" not in argv:
                line += " --no-daemon"
        msg = handoff
        if role == "coordinator" and body:
            is_claude = Path(line.split()[0]).name == "claude"
            if is_claude and "--append-system-prompt" not in line and "--system-prompt" not in line:
                if "--permission-mode" not in line:
                    line += " --permission-mode auto"
                encoded = base64.b64encode(body.encode()).decode()
                line += f" --append-system-prompt \"$(printf %s '{encoded}' | base64 -d)\""
            else:
                msg = body + "\n\n" + handoff
        one = f"herdr-handoff-{os.getpid()}"
        template = home / ".config" / "herdr-core" / "templates" / "roles" / f"{one}.md"
        template.write_text(
            f"---\nname: {one}\ndescription: A one-off Herdr handoff, removed after use.\n"
            f"command: {CLEAN_ENV} exec {line}\n---\n{msg}\n", encoding="utf-8")
        try:
            run = _hc("run", "--bg", "--json", "--no-parent", *(["--cwd", cwd] if cwd else []), *new_labels,
                      "--label", f"herdr.agent={key}", one)
            out = json.loads(run.stdout or "{}")
            new = out.get("address")
            if new and out.get("first_message", {}).get("sent") is False:
                _hc("wait", new, "--timeout", "90", required=False)
                _hc("send", new, msg, required=False)
        finally:
            template.unlink(missing_ok=True)

    if not new:
        raise InstallError("the agent did not restart")
    _hc("kill", old, required=False)
    _hc("rm", old, required=False)
    print(new)
    return 0



def intake_event(args) -> int:
    raw = sys.stdin.read() if args.file == "-" else Path(args.file).read_text(encoding="utf-8")
    try:
        event = json.loads(raw)
    except ValueError as exc:
        raise InstallError(f"invalid event JSON: {exc}") from exc
    if args.space:
        event["space_candidates"] = [args.space]
    token = args.token or (os.environ.get(args.token_env) if args.token_env else None)
    result = _service_post(args.root, "/v1/ingress", event, args.state_dir,
                           {"authorization": f"Bearer {token}"} if token else None)
    print(json.dumps(result, ensure_ascii=False))
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog=NAME, description=__doc__)
    sub = result.add_subparsers(dest="command", required=True)

    def common(command, confirmation=True):
        command.add_argument("--root", type=Path, default=Path.home(), help="isolated HOME (default: real HOME)")
        command.add_argument("--dry-run", action="store_true")
        if confirmation:
            command.add_argument("--yes", action="store_true")

    for name, function in (("install", install), ("update", update)):
        command = sub.add_parser(name)
        common(command)
        command.add_argument("--adopt", action="store_true")
        command.add_argument("--keys", choices=("ask", "keep", "ours"), default="ask")
        command.set_defaults(function=function)
    command = sub.add_parser("doctor")
    command.add_argument("--root", type=Path, default=Path.home())
    command.set_defaults(function=doctor)
    command = sub.add_parser("status")
    command.add_argument("--root", type=Path, default=Path.home())
    command.set_defaults(function=status)
    service = sub.add_parser("service")
    service_sub = service.add_subparsers(dest="service_command", required=True)
    status_command = service_sub.add_parser("status")
    status_command.add_argument("--root", type=Path, default=Path.home())
    status_command.set_defaults(function=service_status)
    for name, function in (("install", service_install), ("uninstall", service_uninstall),
                           ("start", service_start), ("stop", service_stop)):
        command = service_sub.add_parser(name)
        command.add_argument("--root", type=Path, default=Path.home())
        command.add_argument("--dry-run", action="store_true")
        command.set_defaults(function=function)
    roles = sub.add_parser("roles")
    roles_sub = roles.add_subparsers(dest="roles_command", required=True)
    roles_list_command = roles_sub.add_parser("list")
    roles_list_command.add_argument("--root", type=Path, default=Path.home())
    roles_list_command.add_argument("--state-dir", type=Path)
    roles_list_command.set_defaults(function=roles_list)

    ticket = sub.add_parser("ticket")
    ticket_sub = ticket.add_subparsers(dest="ticket_command", required=True)
    create = ticket_sub.add_parser("create")
    create.add_argument("--root", type=Path, default=Path.home())
    create.add_argument("--state-dir", type=Path)
    create.add_argument("--space", required=True)
    create.add_argument("--project", help="project folder under the space's projects directory")
    create.add_argument("--playbook", help="playbook id from the role/playbook registry")
    create.add_argument("--title", required=True)
    create.add_argument("--brief", required=True)
    create.add_argument("--kind", choices=("build", "review"), default="build")
    create.set_defaults(function=ticket_create)
    adopt = ticket_sub.add_parser("adopt")
    adopt.add_argument("--root", type=Path, default=Path.home())
    adopt.add_argument("--state-dir", type=Path)
    adopt.add_argument("--space", required=True)
    adopt.add_argument("--task", required=True)
    adopt.add_argument("--folder", required=True)
    adopt.add_argument("--kind", choices=("build", "review"), default="build")
    adopt.set_defaults(function=ticket_adopt)
    show = ticket_sub.add_parser("show")
    show.add_argument("--root", type=Path, default=Path.home())
    show.add_argument("--state-dir", type=Path)
    show.add_argument("--decision")
    show.add_argument("--ticket")
    show.set_defaults(function=ticket_show)

    intake = sub.add_parser("intake")
    intake_sub = intake.add_subparsers(dest="intake_command", required=True)
    intake_event_command = intake_sub.add_parser("event")
    intake_event_command.add_argument("--root", type=Path, default=Path.home())
    intake_event_command.add_argument("--state-dir", type=Path)
    intake_event_command.add_argument("--file", default="-", help="Event JSON file, or - for stdin")
    intake_event_command.add_argument("--space", help="set space_candidates to this space")
    intake_event_command.add_argument("--token", help="native ingress bearer token")
    intake_event_command.add_argument("--token-env", help="environment variable holding the ingress token")
    intake_event_command.set_defaults(function=intake_event)

    decision = sub.add_parser("decision")
    decision_sub = decision.add_subparsers(dest="decision_command", required=True)
    commit = decision_sub.add_parser("commit")
    commit.add_argument("--root", type=Path, default=Path.home())
    commit.add_argument("--state-dir", type=Path)
    commit.add_argument("--space", required=True)
    commit.add_argument("--project")
    commit.add_argument("--file", default="-")
    commit.set_defaults(function=decision_commit)

    coordinator = sub.add_parser("coordinator")
    coordinator_sub = coordinator.add_subparsers(dest="coordinator_command", required=True)
    restart = coordinator_sub.add_parser("restart")
    restart.add_argument("terminal")
    restart.add_argument("--argv")
    restart.add_argument("--chat")
    restart.add_argument("--resume", action="store_true")
    restart.set_defaults(function=coordinator_restart)

    command = sub.add_parser("uninstall")
    common(command)
    command.set_defaults(function=uninstall)
    return result


def main(argv=None) -> int:
    args = parser().parse_args(argv)
    try:
        return args.function(args)
    except InstallError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("cancelled", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
