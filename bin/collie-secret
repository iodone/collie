#!/usr/bin/env python3
"""collie-secret: secrets for agents (API keys, tokens, passwords), used by name, never seen.

One vault on this machine, ~/.local/share/collie/secrets/vault.json ($COLLIE_SECRETS_HOME moves it),
owner-only (folder 0700, file 0600), by name: {version, secrets: {NAME: {value, why, at}}}. That is
the same file Collie's chat writes when the person answers an ask card (mods/collie-chat/core/
secrets.js), so a value bought there is usable here and the other way round. A value never goes
through hc send, a chat, a log or an artifact: `ask` leaves only the name and the why on the agent's
terminal, and `run` keeps the value in the command's environment and masks it in its output.

Agents (in a Collie terminal, $HC_TERMINAL_ID):
  collie-secret ask NAME --why "what it's for"   a masked card in the agent's chat; end the turn
  collie-secret run NAME[,NAME] -- <command>     values only in the command's environment; its
                                                 output masks them
  collie-secret list                             the names you can use

The person:
  collie-secret set NAME [--why TEXT]            value from stdin (a hidden prompt in a tty)
  collie-secret rm NAME
  collie-secret names [--json]                   every entry, without values
  collie-secret init                             make the vault (owner-only) if it's missing

The ask is a label on the agent's own terminal, collie.secret.ask.NAME=<why> ("-" for none): the
chat's ask card (mods/collie-chat/secret-card.js) shows it, writes the value into this vault, and
tells the agent it's kept, by name only. Collie isn't a sandbox: anything running as the same
account can read an owner-only file; this keeps values out of chats, logs and transcripts.

Not ported from shepherdr's herdr-secret: machine levels (Everywhere / a machine / a space), the
remote keeper and its FIFO answer (serve, install --on, mark-remote, where, move-to), and `env`
(env files a git repo ignores).
"""

import argparse
import fcntl
import getpass
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
# The label an agent's terminal carries while it waits on a secret (the ask card answers it).
ASK = "collie.secret.ask."
NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,99}$")
# Values shorter than this aren't masked in output (a one-letter value would mask every letter).
MASK_MIN = 4


class Fail(Exception):
    pass


def say(text):
    sys.stdout.write(text.rstrip("\n") + "\n")


# ---- the vault ------------------------------------------------------------------------------

def vault_dir():
    """Where this machine keeps its secrets: $COLLIE_SECRETS_HOME, else ~/.local/share/collie/secrets
    (the same store Collie's chat uses, not shepherdr's)."""
    moved = str(os.environ.get("COLLIE_SECRETS_HOME") or "").strip()
    return moved or os.path.join(HOME, ".local", "share", "collie", "secrets")


def vault_path():
    return os.path.join(vault_dir(), "vault.json")


def init_vault():
    """The vault, made owner-only if missing; its folder and mode put right if they aren't."""
    folder = vault_dir()
    os.makedirs(folder, exist_ok=True, mode=0o700)
    os.chmod(folder, 0o700)
    path = vault_path()
    if not os.path.exists(path):
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps({"version": 1, "secrets": {}}, indent=2) + "\n")
    os.chmod(path, 0o600)
    return path


def load():
    path = vault_path()
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return {"version": 1, "secrets": {}}
    except ValueError:
        raise Fail(f"The vault ({path}) isn't valid JSON; fix or move it first.")
    if not isinstance(data, dict) or not isinstance(data.get("secrets"), dict):
        raise Fail(f"The vault ({path}) isn't a Collie vault.")
    return data


def save(data):
    init_vault()
    path = vault_path()
    payload = {"version": data.get("version", 1),
               "secrets": {k: data["secrets"][k] for k in sorted(data["secrets"])}}
    payload.update({k: v for k, v in data.items() if k not in ("version", "secrets")})
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def locked(fn):
    init_vault()
    lock = vault_path() + ".lock"
    with open(lock, "a") as lk:
        os.chmod(lock, 0o600)
        fcntl.flock(lk, fcntl.LOCK_EX)
        return fn()


def names():
    """Every name this agent can use, sorted (never a value)."""
    return sorted(n for n, e in load()["secrets"].items()
                  if NAME.match(str(n)) and isinstance(e, dict) and isinstance(e.get("value"), str))


def values(wanted):
    data, found, missing = load(), {}, []
    for n in wanted:
        e = data["secrets"].get(n)
        if isinstance(e, dict) and isinstance(e.get("value"), str):
            found[n] = e["value"]
        else:
            missing.append(n)
    if missing:
        raise Fail(f"No secret {', '.join(missing)} for you. Ask for it: collie-secret ask {missing[0]} --why \"what it's for\".")
    return found


def names_arg(s):
    wanted = [n.strip() for n in str(s).split(",") if n.strip()]
    if not wanted or len(wanted) > 32 or any(not NAME.match(n) for n in wanted):
        raise Fail("Name secrets like environment variables, comma-separated: GITHUB_TOKEN,OPENAI_API_KEY.")
    return list(dict.fromkeys(wanted))


# ---- who is asking ----------------------------------------------------------------------------

def hc_json(*args):
    try:
        r = subprocess.run(["hc", *args, "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    try:
        return json.loads(r.stdout or "null")
    except ValueError:
        return None


def parent_pid(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
        return int(s[s.rindex(")") + 2:].split()[1])
    except (OSError, ValueError, IndexError):
        pass
    try:
        r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        return int(r.stdout.strip())
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0


def ancestors():
    out, pid = set(), os.getpid()
    for _ in range(64):
        pid = parent_pid(pid)
        if pid <= 1 or pid in out:
            break
        out.add(pid)
    return out


def me():
    """This process's own terminal: {address, labels}. The terminal is the one this process runs
    in: $HC_TERMINAL_ID must be an ancestor of it."""
    tid = str(os.environ.get("HC_TERMINAL_ID") or "").strip()
    if not tid or "/" in tid:
        raise Fail("collie-secret works for an agent in a Collie terminal: $HC_TERMINAL_ID isn't set here.")
    t = hc_json("get", tid)
    if not isinstance(t, dict) or t.get("error") or t.get("state") not in (None, "live"):
        raise Fail(f"Can't find this terminal ({tid}) in herdr-core.")
    pids = {p for p in (t.get("pid"), (t.get("foreground") or {}).get("pid")) if isinstance(p, int)}
    if not pids & ancestors():
        raise Fail(f"This process doesn't run in terminal {tid}: use secrets from the agent's own terminal.")
    labels = t.get("labels") or {}
    if labels.get("herdr.role") == "reviewer":
        raise Fail("Reviewers can't use secrets.")
    return {"address": tid, "labels": labels}


# ---- masking output ---------------------------------------------------------------------------

class Masker:
    """Replaces exact values in a byte stream, including a value split across chunks: what could
    still be the start of a value waits for the next chunk."""

    def __init__(self, found):
        self.subs = sorted(((v.encode(), f"[{n} hidden]".encode()) for n, v in found.items() if len(v) >= MASK_MIN),
                           key=lambda x: -len(x[0]))
        self.pending = b""

    def feed(self, chunk):
        buf = self.pending + chunk
        for v, mark in self.subs:
            buf = buf.replace(v, mark)
        hold = 0
        for v, _ in self.subs:
            for k in range(min(len(v) - 1, len(buf)), hold, -1):
                if buf.endswith(v[:k]):
                    hold = k
                    break
        self.pending = buf[len(buf) - hold:] if hold else b""
        return buf[:len(buf) - hold] if hold else buf

    def flush(self):
        out, self.pending = self.pending, b""
        return out


def pump(src, dst, masker):
    out = dst.buffer if hasattr(dst, "buffer") else dst
    while True:
        chunk = os.read(src.fileno(), 65536)
        if not chunk:
            break
        data = masker.feed(chunk)
        if data:
            out.write(data)
            out.flush()
    out.write(masker.flush())
    out.flush()


def cmd_run(wanted, argv):
    if not argv:
        raise Fail("Say what to run: collie-secret run NAME -- <command>.")
    me()
    found = values(wanted)
    env = dict(os.environ)
    env.update(found)
    try:
        p = subprocess.Popen(argv, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e:
        raise Fail(f"Couldn't run {argv[0]}: {e.strerror}")
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: p.send_signal(s))
    threads = [threading.Thread(target=pump, args=(p.stdout, sys.stdout, Masker(found)), daemon=True),
               threading.Thread(target=pump, args=(p.stderr, sys.stderr, Masker(found)), daemon=True)]
    for t in threads:
        t.start()
    code = p.wait()
    for t in threads:
        t.join()
    return code if code >= 0 else 128 - code


# ---- asking -----------------------------------------------------------------------------------

def cmd_ask(name, why, force):
    if not NAME.match(name):
        raise Fail("Name the secret like an environment variable: GITHUB_TOKEN.")
    t = me()
    if not force and name in names():
        say(f"{name} is already kept for you: use it by name (collie-secret run {name} -- <command>). "
            "If it's wrong or expired, ask again with --force.")
        return 0
    why = re.sub(r"\s+", " ", why or "").strip()[:300]
    try:
        r = subprocess.run(["hc", "label", t["address"], f"{ASK}{name}={why or '-'}"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Fail(f"Couldn't ask: {e}")
    if r.returncode != 0:
        raise Fail(f"Couldn't ask: {r.stderr.strip()}")
    say(f"Asked the person for {name} in a masked box in your chat. End your turn now and wait: you'll get a "
        f"line saying it's kept (by name only). Then use it with collie-secret run {name} -- <command>. "
        "Never ask for its value in the chat.")
    return 0


def cmd_list():
    me()
    kept = names()
    if not kept:
        say("No secrets for you yet. Ask: collie-secret ask NAME --why \"what it's for\".")
        return 0
    for n in kept:
        say(n)
    return 0


# ---- the person's side ------------------------------------------------------------------------

def read_value():
    if sys.stdin.isatty():
        value = getpass.getpass("value: ")
    else:
        value = sys.stdin.read()
    value = value.rstrip("\r\n")
    if not value:
        raise Fail("Give the value on stdin (collie-secret set NAME < file), never in the command's words.")
    return value


def cmd_set(name, why):
    if not NAME.match(name):
        raise Fail("Name the secret like an environment variable: GITHUB_TOKEN.")
    value = read_value()
    why = re.sub(r"\s+", " ", why or "").strip()[:300]

    def go():
        data = load()
        data["secrets"][name] = {"value": value, "why": why, "at": int(time.time() * 1000)}
        save(data)
    locked(go)
    say(f"Kept {name}.")
    return 0


def cmd_rm(name):
    if not NAME.match(name):
        raise Fail("Name the secret like an environment variable: GITHUB_TOKEN.")

    def go():
        data = load()
        had = data["secrets"].pop(name, None) is not None
        if had:
            save(data)
        return had
    say(f"Removed {name}." if locked(go) else f"No {name} kept.")
    return 0


def cmd_names(as_json):
    rows = [{"name": n, "why": str(e.get("why") or ""), "at": e.get("at")} if isinstance(e, dict) else {"name": n}
            for n, e in sorted(load()["secrets"].items()) if NAME.match(str(n))]
    if as_json:
        say(json.dumps(rows))
        return 0
    if not rows:
        say("No secrets kept yet. The value is never printed: collie-secret set NAME < file.")
        return 0
    for row in rows:
        say(row["name"])
    return 0


def main(argv):
    rest = []
    if "--" in argv:
        i = argv.index("--")
        argv, rest = argv[:i], argv[i + 1:]
    p = argparse.ArgumentParser(prog="collie-secret", description="Secrets for agents, used by name, never seen.")
    sub = p.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("ask", help="ask the person for a secret in a masked card; then end your turn")
    c.add_argument("name")
    c.add_argument("--why", default="", help="what it's for, in a few words")
    c.add_argument("--force", action="store_true", help="ask even though one is kept (wrong or expired)")
    c = sub.add_parser("run", help="run a command with secrets in its environment; its output masks them")
    c.add_argument("names")
    sub.add_parser("list", help="the names you can use")
    c = sub.add_parser("set", help="the person: keep a value (from stdin)")
    c.add_argument("name")
    c.add_argument("--why", default="", help="what it's for, in a few words")
    c = sub.add_parser("rm", help="the person: remove one")
    c.add_argument("name")
    c = sub.add_parser("names", help="every entry, without values")
    c.add_argument("--json", action="store_true")
    sub.add_parser("init", help="make the vault (owner-only) if it's missing")
    a = p.parse_args(argv)
    if a.cmd != "run" and rest:
        p.error("only run takes a command after --")
    if a.cmd == "ask":
        return cmd_ask(a.name, a.why, a.force)
    if a.cmd == "run":
        return cmd_run(names_arg(a.names), rest)
    if a.cmd == "list":
        return cmd_list()
    if a.cmd == "set":
        return cmd_set(a.name, a.why)
    if a.cmd == "rm":
        return cmd_rm(a.name)
    if a.cmd == "names":
        return cmd_names(a.json)
    if a.cmd == "init":
        say(init_vault())
        return 0
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        sys.stderr.write(f"collie-secret: {e}\n")
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
