#!/usr/bin/env python3
"""Start the native interactive Codex/Claude coordinator for the current herdr tab."""
import json
import os
from pathlib import Path
import shutil
import sys

HOME = Path.home()
STATE = HOME / ".local/state/collie"
space = sys.argv[sys.argv.index("--space") + 1] if "--space" in sys.argv else "default"
settings = json.loads((STATE / "coordinator.json").read_text()) if (STATE / "coordinator.json").is_file() else {}
config = {**settings.get("everywhere", {}).get("coordinator", {}), **settings.get("spaces", {}).get(space, {}).get("coordinator", {})}
cli = config.get("cli")
if cli not in ("codex", "claude"):
    raise SystemExit("Inbox Coordinator is not configured: open Collie settings and choose Codex or Claude.")
command = shutil.which(cli)
if not command:
    raise SystemExit(f"{cli} is not installed or not on PATH")
role = HOME / ".config/herdr-core/templates/collie-coordinator.md"
prompt = role.read_text() if role.is_file() else ""
if not prompt.strip():
    raise SystemExit(f"missing coordinator role prompt: {role}")
runtime_path = STATE / "coordinator-runtime.json"
runtime = json.loads(runtime_path.read_text()) if runtime_path.is_file() else {}
record = runtime.get("spaces", {}).get(space, {})
session = record.get("session")
terminal_id = os.environ.get("HC_TERMINAL_ID")
if terminal_id:
    import subprocess
    subprocess.run(["hc", "label", terminal_id, "herdr.role=coordinator", "herdr.inbox=true", f"herdr.coordinator.space={space}"], capture_output=True)
model = config.get("model")
effort = config.get("effort")
if cli == "codex":
    args = [command, "--no-daemon", "--sandbox", "read-only"]
    if model and model != "default":
        args += ["--model", model]
    if effort:
        args += ["-c", f'model_reasoning_effort="{effort}"']
    if session:
        args += ["resume", session]
else:
    args = [command, "--permission-mode", "plan"]
    if model and model != "default":
        args += ["--model", model]
    if effort:
        args += ["--effort", effort]
    if session:
        args += ["--resume", session]
args.append(prompt)
if os.environ.get("HERDR_INBOX_TERMINAL_DRY_RUN") == "1":
    print(json.dumps({"command": command, "args": args[:-1], "role": str(role)}))
else:
    os.execvpe(command, args, os.environ)
