{
  "name": "collie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "herdr 的双循环插件（M0–M7）",
  "scripts": {
    "test": "node --test protocol/test/*.test.mjs && bun test test/*.test.ts && bun test mods/collie-chat/tests/*.test.js && bun test mods/collie-files/tests/*.test.js && python3 test/install.test.py",
    "test:schema": "node --test protocol/test/schema.test.mjs",
    "test:invariants": "node --test protocol/test/invariants.test.mjs",
    "test:agent": "bun test test/herdr.test.ts",
    "test:ingress": "bun test test/ingress.test.ts",
    "test:install": "python3 test/install.test.py"
  },
  "engines": {
    "node": ">=20"
  }
}
